{
  "name": "biblioteca-central",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd biblioteca-backend && npm run dev",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:frontend": "cd frontend && npm run dev -- --host",
    "start:backend": "cd biblioteca-backend && npm start",
    "seed": "cd biblioteca-backend && npm run seed",
    "install:all": "cd frontend && npm install && cd ../biblioteca-backend && npm install",
    "setup": "npm run install:all && npm run seed",
    "build": "cd frontend && npm run build",
    "lint": "oxlint",
    "preview": "cd frontend && npm run preview"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "oxlint": "^1.75.0"
  }
}
